+/// TCS instructions that close a straight-line `TSC; CLC; ADC #imm; TCS` or
+/// `TSC; SEC; SBC #imm; TCS` run (16-bit A), mapped to the stack delta they
+/// apply. C compilers (Koei's among them) pop call arguments this way, so the
+/// height after the TCS is still known.
+fn arithmetic_tcs_deltas(graph: &FunctionDecodeGraph) -> HashMap<DecodeKey, i32> {
+    let mut predecessors: HashMap<DecodeKey, HashSet<DecodeKey>> = HashMap::new();
+    for di in graph.insns() {
+        for successor in &di.successors {
+            if graph.contains(successor) {
+                predecessors
+                    .entry(successor.clone())
+                    .or_default()
+                    .insert(di.key.clone());
+            }
+        }
+    }
+    let single_pred = |key: &DecodeKey| -> Option<&DecodedInsn> {
+        let preds = predecessors.get(key)?;
+        if preds.len() != 1 {
+            return None;
+        }
+        let pred = graph.get(preds.iter().next().unwrap())?;
+        if pred.successors.len() != 1 {
+            return None;
+        }
+        Some(pred)
+    };
+    let mut out = HashMap::new();
+    for di in graph.insns() {
