+            continue;
+        }
+        let want_carry = match a.mnem {
+            "ADC" => "CLC",
+            "SBC" => "SEC",
+            _ => continue,
+        };
+        let Some(carry) = single_pred(&arith.key) else { continue };
+        if carry.insn.mnem != want_carry {
